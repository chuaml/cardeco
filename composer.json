{
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "classmap": [
            "./src/"
        ],
        "files": [
            "./src/global.function.php"
        ]
    },
    "autoload-dev": {
        "classmap": [
            "./tests/"
        ]
    },
    "scripts": {
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "apachectl stop",
            "XDEBUG_MODE=off apache2-foreground"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "apachectl stop",
            "XDEBUG_MODE=develop,debug apache2-foreground"
        ],

        "tests": [
            "php -d memory_limit=-1 -d error_reporting=-1 -d log_errors_max_len=0 -d zend.assertions=1 -d assert.exception=1 -d xdebug.show_exception_trace=0  -d xdebug.mode=Off -d xdebug.show_local_vars=0 -d xdebug.log_level=0 -d xdebug.start_with_request=no ./vendor/bin/phpunit --colors=always"
        ],
        "tests:unit": [
            "php -d memory_limit=-1 -d xdebug.mode=Off ./vendor/bin/phpunit --testsuite unit --colors=always"
        ],
        "tests:integration": [
            "php -d memory_limit=-1 -d xdebug.mode=Off ./vendor/bin/phpunit --testsuite integration --colors=always"
        ],
        "tests:smoke": [
            "php -d memory_limit=-1 -d xdebug.mode=Off ./vendor/bin/phpunit --testsuite smoke --colors=always"
        ],
        "tests:known-bugs": [
            "php -d memory_limit=-1 -d xdebug.mode=Off ./vendor/bin/phpunit --group known-bug --colors=always"
        ],
        "tests:docker": [
            "Composer\\Config::disableProcessTimeout",
            "docker compose -f compose.test.yml run --rm phpunit"
        ],
        "tests:docker:74": [
            "Composer\\Config::disableProcessTimeout",
            "docker compose -f compose.test.yml run --rm phpunit74"
        ],
        "tests:docker:73": [
            "Composer\\Config::disableProcessTimeout",
            "docker compose -f compose.test.yml run --rm phpunit73"
        ],
        "tests:matrix": [
            "Composer\\Config::disableProcessTimeout",
            "docker compose -f compose.test.yml run --rm phpunit73",
            "docker compose -f compose.test.yml run --rm phpunit74",
            "docker compose -f compose.test.yml run --rm phpunit"
        ],
        "tests:docker:down": [
            "docker compose -f compose.test.yml down -v"
        ],
        "lint": [
            "./vendor/bin/phpcs --standard=phpcs.xml.dist"
        ],
        "lint:syntax": [
            "@php dev.tool/lint-syntax.php"
        ],
        "lint:php73": [
            "php7.3 dev.tool/lint-syntax.php --with-vendor"
        ],
        "lint:docker:73": [
            "Composer\\Config::disableProcessTimeout",
            "docker compose -f compose.test.yml run --rm -e CARDECO_RUN=lint-syntax phpunit73"
        ],
        "lint:case": [
            "@php dev.tool/audit-case.php"
        ],
        "stan": [
            "./vendor/bin/phpstan analyse -c phpstan.neon --no-progress --memory-limit=1G"
        ],
        "stan:83": [
            "./vendor/bin/phpstan analyse -c phpstan-83.neon --no-progress --memory-limit=1G"
        ],
        "audit:php83": [
            "@php dev.tool/audit-php83.php"
        ],
        "audit:docker": [
            "Composer\\Config::disableProcessTimeout",
            "docker compose -f compose.test.yml run --rm -e CARDECO_RUN=audit phpunit"
        ],
        "check": [
            "Composer\\Config::disableProcessTimeout",
            "@lint",
            "@lint:syntax",
            "@lint:case",
            "@stan",
            "@stan:83"
        ],
        "check:docker": [
            "Composer\\Config::disableProcessTimeout",
            "docker compose -f compose.test.yml run --rm -e CARDECO_RUN=check phpunit"
        ],
        "debug-tests": [
            "XDEBUG_MODE=off composer dumpautoload --no-interaction",
            "php -d xdebug.mode=develop,debug -d xdebug.show_local_vars=1 -d xdebug.log_level=0 -d xdebug.start_with_request=yes -d xdebug.trigger_value=vsc -d xdebug.idekey=vsc ./vendor/bin/phpunit ./tests/ --colors=always"
        ],
        "profile": [
            "XDEBUG_MODE=off composer dumpautoload --no-interaction",
            "php -d xdebug.mode=profile -d xdebug.log_level=0 -d zlib.output_compression=1 -d zlib.output_compression_level=1 ./vendor/bin/phpunit ./tests/ --colors=always"
        ],
        "reload": [
            "XDEBUG_MODE=off composer dumpautoload --no-interaction",
            "XDEBUG_MODE=off composer run tests"
        ]
    },
    "require": {
        "php": ">=7.3",
        "phpoffice/phpspreadsheet": "^1.25"
    },
    "require-dev": {
        "phpcompatibility/php-compatibility": "^10.0@alpha",
        "phpstan/phpstan": "^1.12",
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "config": {
        "platform": {
            "php": "7.3.33"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "audit": {
            "block-insecure": false
        }
    }
}
