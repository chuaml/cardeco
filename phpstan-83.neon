# PHPStan profile 2 of 2 (TODO.md 1.3): the same analysis as phpstan.neon, with the code read as PHP 8.3 -
# the dev container runtime. Catches what only breaks on 8.x: changed internal function signatures and
# tentative return types of internal interfaces (ArrayAccess, IteratorAggregate, Countable, JsonSerializable).
#   composer run stan:83
includes:
    - phpstan.neon

parameters:
    phpVersion: 80300
    tmpDir: analysis/phpstan-83
    # both profiles share phpstan-baseline.neon; an entry that only one PHP version produces must not fail the other
    reportUnmatchedIgnoredErrors: false
